class Node:
    def __init__(self, c, e):
        self.c = c
        self.e = e
        self.next = None


class Poly:
    def __init__(self):
        self.head = None

    def insert(self, c, e):
        n = Node(c, e)

        if not self.head or self.head.e < e:
            n.next = self.head
            self.head = n
        else:
            p = self.head

            while p.next and p.next.e > e:
                p = p.next

            if p.e == e:
                p.c += c
            elif p.next and p.next.e == e:
                p.next.c += c
            else:
                n.next = p.next
                p.next = n

    def show(self):
        p = self.head
        s = []

        while p:
            s.append(f"{p.c}x^{p.e}" if p.e else str(p.c))
            p = p.next

        return "+".join(s)

    def value(self, x):
        p = self.head
        total = 0

        while p:
            total += p.c * x ** p.e
            p = p.next

        return total


def add(a, b):
    r = Poly()
    p, q = a.head, b.head

    while p and q:
        if p.e == q.e:
            r.insert(p.c + q.c, p.e)
            p = p.next
            q = q.next
        elif p.e > q.e:
            r.insert(p.c, p.e)
            p = p.next
        else:
            r.insert(q.c, q.e)
            q = q.next

    while p:
        r.insert(p.c, p.e)
        p = p.next

    while q:
        r.insert(q.c, q.e)
        q = q.next

    return r


p1, p2 = Poly(), Poly()

p1.insert(4, 2)
p1.insert(3, 1)
p1.insert(6, 0)

p2.insert(2, 2)
p2.insert(5, 0)

r = add(p1, p2)

print("Tax Formula1:", p1.show())
print("Tax Formula2:", p2.show())
print("Combined Tax Formula:", r.show())

x = 3
print("Tax Amount for income =", x, ":", r.value(x))
